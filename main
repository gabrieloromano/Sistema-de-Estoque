import os
from time import sleep
import json

def pergunta(mensagem):
    while True:
        menu = input(f"\n{mensagem}\n[1] Sim\n[2] Não\n\nSeleção: ").lower()
        match menu:
            case "1" | "sim":
                return True
            case "2" | "nao" | "não" :
                return False
            case _:
                print("\nInsira uma opção válida.")
                continue

class ErroValor(Exception):
    def __init__(self, mensagem):
        self.mensagem = mensagem


class Produto:
    def __init__(self, codigo, nome, valor, categoria, unid_medida, ponto_pedido = 0, saldo=0):
        self.codigo = codigo
        self.nome = nome
        self.valor = float(valor)
        self.categoria = categoria
        self.unid_medida = unid_medida
        self.ponto_pedido = ponto_pedido
        self.saldo = saldo

    def __repr__(self):
        return f"{self.codigo, self.nome, self.valor, self.categoria, self.unid_medida, self.ponto_pedido, self.saldo}"

    def entrada(self, quantidade):
        self.saldo += quantidade
        print(f"\nFoi dada a entrada de {quantidade}{self.unid_medida} para o item {self.nome}.\nQuantidade em estoque atual: {self.saldo}.")

    def saida(self, quantidade):
        if self.saldo < quantidade:
            raise ErroValor(f"\nO valor inserido ({quantidade}) é maior que o saldo ({self.saldo}) do item. Insira um valor válido.")
        self.saldo -= quantidade
        if self.saldo < self.ponto_pedido:
            print(f"\nFoi dada a saída de {quantidade}{self.unid_medida} para o item {self.nome}.\nQuantidade em estoque atual: {self.saldo}.\nAlerta! O item {self.nome} entrou em ponto de pedido.")
        else:
            print(f"Foi dada a saída de {quantidade}{self.unid_medida} para o item {self.nome}.\nQuantidade em estoque atual: {self.saldo}.")

    def exibir(self):
        print(f"\nCodigo do produto: {self.codigo}\n"
              f"Nome do produto: {self.nome}\n"
              f"Valor atual do produto: R${self.valor:.2f}\n"
              f"Quantidade do item em estoque: {self.saldo}{self.unid_medida}\n"
              f"Categoria do item: {self.categoria}\n"
              f"Ponto de pedido: {self.ponto_pedido}\n" \
              f"Valor total em estoque: R${self.valor * self.saldo:.2f}")

    def isPontoPed(self):
        return self.saldo <= self.ponto_pedido

class Estoque:

    def __init__(self, nome):
        self.nome = nome
        self.unid_medida = ["MT", "KG", "UN", "CJ"]
        self.categorias = ["VEDACAO", "ELEMENTO DE FIXACAO"]
        self.armazem = []
        self.armazem_dict = []
        self.caminho = f"Estoques/{self.nome}.json"

    def fechar(self):
        self.save_armazem()
        print("\nFechando o programa.")
        sleep(1.5)

    def load_armazem(self):
        if os.path.isfile(self.caminho):
            arq = open(self.caminho, "r")
            self.armazem_dict = json.load(arq)
            for prod in self.armazem_dict:
                self.armazem.append(Produto(**prod))

    def save_armazem(self):
        self.armazem_dict = []
        arq = open(self.caminho, "w")
        for item in self.armazem:
            self.armazem_dict.append(item.__dict__)
        json.dump(self.armazem_dict, arq)
        arq.close()

    def get_item(self, cod):
        for item in self.armazem:
                if item.codigo == cod:
                    return item
        else:
            raise ErroValor("\nNão foi possível encontrar o código inserido. Tente novamente!")
                
    def validar_valor(self, um=0, cat=0):
        if um != 0 and um not in self.unid_medida:
            raise ErroValor("Insira uma opcao valida.")
        if cat != 0 and cat not in self.categorias:
            raise ErroValor("Insira uma opcao valida.")

    def validar_cod(self, codigo):
        for item in self.armazem:
            if item.codigo == codigo:
                raise ErroValor("O codigo inserido ja esta em uso.")

    def isnegative(self, valor):
        if valor < 0:
            raise ErroValor("\nO valor inserido é negativo. Insira um valor válido!")
        
    def cadastrar_produto(self):

        while True:

            print(f"\n======== CADASTRO ========\n")

            while True:
                try:
                    codigo = input("Defina um codigo para o produto: ")
                    self.validar_cod(codigo)
                    break
                except ErroValor:
                    print("O codigo inserido ja esta em uso. Insira outro codigo.\n")

            
            nome = input("\nDigite o nome do produto: ")

            while True:
                try:
                    valor = float(input("\nDigite o valor do produto: "))
                    self.isnegative(valor)
                    break
                except ValueError:
                    print("\nDigite um valor valido para o produto!")
                except ErroValor:
                    print("\nO valor inserido (negativo) não é suportado, insira outro valor!")


            while True:
                try:
                    unid_medida = input(f"\nDigite a unidade de medida do produto {self.unid_medida}: ").upper()
                    self.validar_valor(um=unid_medida)
                    break
                except ErroValor:
                    print("\nA unidade de medida inserida não é válida. Tente novamente!")

            while True:
                    try:
                        categoria = input(f"\nDigite a categoria do produto: ").upper()
                        self.validar_valor(cat=categoria)
                        break
                    except ErroValor:
                        print("\nA categoria inserida não é válida. Tente novamente!")

            if pergunta("Deseja adicionar um ponto de pedido ao produto?"):
                while True:
                    ponto_ped = float(input("\nDigite o ponto de pedido a ser adicionado: "))
                    try: 
                        self.isnegative(ponto_ped)
                        break
                  
                    except ErroValor:
                        print("\nO valor inserido (negativo) não é suportado, insira outro valor!")
                        continue

            else:
                ponto_ped = 0

            produto_cadastro = Produto(codigo, nome, valor, categoria, unid_medida, ponto_ped)

            if pergunta("Deseja adicionar saldo ao produto?"):
                while True:
                    saldo1 = float(input("\nDigite o saldo a ser adicionado: "))
                    try:
                        self.isnegative(saldo1)
                        break
                    except ErroValor:
                        print("\nO valor inserido (negativo) não é suportado, insira outro valor!")
                        continue

                produto_cadastro.entrada(saldo1)

            else:
                pass
            
            print(f"\nProduto cadastrado com sucesso!")
            produto_cadastro.exibir()

            self.armazem.append(produto_cadastro)

            if pergunta("Deseja cadastrar um novo produto?"):
                continue
            else:
                break

    def delete_item(self):
        while True:

            print("\n======== DELETAR PRODUTO ========\n")

            if pergunta("Deseja listar os itens em estoque?"):
                            for item in self.armazem:
                                print(f"\nCodigo: {item.codigo} | Nome: {item.nome} | Valor: {item.valor} | Saldo: {item.saldo} | Ponto de Pedido: {"Sim" if item.isPontoPed() else "Não"}\n")

            while True:
                try:
                    cod = input("\nDigite o código a ser alterado: ")
                    produto_deletado = self.get_item(cod)
                    break
                except ErroValor:
                    print("\nO código digitado é inválido. Tente novamente!")

            
            if pergunta("\nO item será deletado, esta ação não pode ser revertida. Deseja prosseguir?"):
                if produto_deletado.saldo != 0:
                    if pergunta(f"\nO item selecionado ainda tem saldo no sistema:{produto_deletado.saldo}. Deseja prosseguir?"):
                        pass
                    else:
                        print("\nCancelando ação e retornando ao menu...\n")
                        sleep(1.5)
                        break
                index_prod = self.armazem.index(produto_deletado)
                self.armazem.pop(index_prod)
            else:
                print("\nCancelando ação e retornando ao menu...\n")
                sleep(1.5)
                break

            print("\nProduto deletado com sucesso!")

            if pergunta("Deseja deletar outro produto?"):
                continue
            else:
                break

    def alterar_item(self):
        while True:

            print("\n======== ALTERAR PRODUTO ========\n")

            if pergunta("Deseja listar os itens em estoque?"):
                for item in self.armazem:
                    print(f"\nCodigo: {item.codigo} | Nome: {item.nome} | Valor: {item.valor} | Saldo: {item.saldo} | Ponto de Pedido: {"Sim" if item.isPontoPed() else "Não"}\n")

            else:
                pass

            while True:
                try:
                    cod = input("\nDigite o código a ser alterado: ")
                    produto_alterado = self.get_item(cod)
                    break
                except ErroValor:
                    print("\nO código digitado é inválido. Tente novamente!")

            opcoes = ["[1] Codigo",
                        "[2] Nome",
                        "[3] Valor",
                        "[4] Unidade de Medida",
                        "[5] Categoria",
                        "[6] Ponto de Pedido",
                        "[7] Saldo"]
        
            for op in opcoes:
                print(f"\n{op}")

            selecao = int(input(f"\nSelecione a opção desejada: "))

            match selecao:
                case 1:
                    while True:
                        try:
                            novo_codigo = input("\nDigite o novo codigo para o produto: ")
                            if novo_codigo == produto_alterado.codigo:
                                print("\nO código inserido já é o atualmente utilizado para este produto! Tente novamente!")
                                continue
                            self.validar_cod(novo_codigo)
                            produto_alterado.codigo = novo_codigo
                            break
                        except ErroValor:
                            print("\nO código inserido já está em uso. Tente novamente!\n")

                case 2:
                    novo_nome = input("\nDigite o novo nome para o produto: ")
                    produto_alterado.nome = novo_nome 

                case 3:
                    while True:
                        try:
                            novo_valor = float(input("\nDigite o novo valor para o produto: "))
                            self.isnegative(novo_valor)
                            produto_alterado.valor = novo_valor
                            break
                        except ValueError:
                            print("\nDigite um valor valido para o produto: ")
                        except ErroValor:
                            print("\nO valor inserido (negativo) não é suportado, insira outro valor!")

                case 4:
                    while True:
                        try:
                            nova_unid_medida = input("\nDigite a nova Unidade de Medida para o produto: ").upper()
                            self.validar_valor(um=nova_unid_medida)
                            produto_alterado.unid_medida = nova_unid_medida
                            break
                        except ErroValor:
                            print("\nDigite uma Unidade de Medida valida: ")

                case 5:
                    while True:
                        try:
                            nova_categoria = input("\nDigite a nova categoria para o produto: ").upper()
                            self.validar_valor(cat=nova_categoria)
                            produto_alterado.categoria = nova_categoria
                            break
                        except ErroValor:
                            print("\nDigite uma categoria valida: ")

                case 6:
                    while True:
                        try:
                            novo_ponto_pedido = float(input("\nDigite o novo Ponto de Pedido para o produto: "))
                            self.isnegative(novo_ponto_pedido)
                            produto_alterado.ponto_pedido = novo_ponto_pedido
                            break
                        except ValueError:
                            print("\nDigite um valor de Ponto de Pedido valido: ")
                        except ErroValor:
                            print("\nO valor inserido (negativo) não é suportado, insira outro valor!")

                case 7:
                    while True:
                        try:
                            novo_saldo = float(input("\nDigite o novo saldo para o produto: "))
                            self.isnegative(novo_saldo)
                            produto_alterado.saldo = novo_saldo
                            break
                        except ValueError:
                            print("\nDigite um valor de saldo valido: ")
                        except ErroValor:
                            print("\nO valor inserido (negativo) não é suportado, insira outro valor!")

                case _:
                    print("\nInsira uma opção válida.")
                    continue

            produto_alterado.exibir()

            if pergunta("O produto foi alterado com sucesso! Deseja alterar mais alguma informação?"):
                continue
            else:
                produto_alterado = None
                pass

            return

    def menu_estoque(self):

        self.load_armazem()
        
        opcoes = ["[1] Cadastrar produto",
                  "[2] Consultar produto",
                  "[3] Alterar produto",
                  "[4] Entrada de estoque",
                  "[5] Saida de estoque",
                  "[6] Consultar estoque geral",
                  "[7] Valor de estoque",
                  "[8] Deletar produto",
                  "[9] Sair"]

        while True:
            self.save_armazem()
            print("======== ESTOQUE ========\n")

            for op in opcoes:
                print(f"\n{op}")

            while True:
                try:
                    selecao = int(input(f"\nSelecione uma opção: "))
                    self.isnegative(selecao)
                    break
                except ValueError:
                    print("\nInsira uma opção válida.")
                    continue
                except ErroValor:
                    print("\nInsira um número não negativo válido!")
                    continue

            match selecao:
                case 1:
                    self.cadastrar_produto()

                case 2:
                    if len(self.armazem) <= 0:
                        print("\nNão há itens para consulta. Retornando ao menu...")
                        sleep(3)
                        continue

                    while True:
                        cod = input("\nDigite o código desejado: ")
                        try:
                            self.get_item(cod).exibir()
                            break
                        except ErroValor:
                            print(f"\nNão foi possível encontrar o código inserido. Tente novamente!")
                            continue
            
                    if pergunta("Deseja retornar ao menu?"):
                        continue
                    else:
                        self.fechar()
                        break
                            
                case 3:
                    if len(self.armazem) <= 0:
                        print("\nNão há itens para alterar. Retornando ao menu...")
                        sleep(3)
                        continue
                    self.alterar_item()

                case 4:
                    while True:
                        cod = input("\nDigite o código do produto a ser dada entrada: ")
                        try:
                            produto_entrada = self.get_item(cod)
                            break
                        except ErroValor:
                            print(f"\nNão foi possível encontrar o código inserido. Tente novamente!")
                            continue
                    
                        
                    while True:
                        entrada = float(input("\nDigite o valor a ser adicionado ao saldo do item: "))
                        try:
                            self.isnegative(entrada)
                            produto_entrada.entrada(entrada)
                            break
                        except ValueError:
                            print("\nInsira um valor valido: ")
                        except ErroValor:
                            print("\nO valor inserido é inválido (negativo). Insira um valor válido.")

                        
                    if pergunta("Deseja retornar ao menu?"):
                        continue
                    else:
                        self.fechar()
                        break

                case 5:
                    while True:
                        cod = input("\nDigite o código do produto a ser dado saida: ")
                        try:
                            produto_saida = self.get_item(cod)
                            break
                        except ErroValor:
                            print("\nNão foi possível encontrar o código inserido. Tente novamente!")
                            continue
                        
                    while True:
                        try:
                            saida = float(input("\nDigite o valor a ser retirado do saldo do item: "))
                            self.isnegative(saida)
                            produto_saida.saida(saida)
                            break
                        except ValueError:
                            print("\nInsira um valor valido: ")
                        except ErroValor as e:
                            print(f"{e}")
                        
                    if pergunta("Deseja retornar ao menu?"):
                        continue
                    else:
                        self.fechar()
                        break

                case 6:
                    abaixo_ponto_ped = []
                    print("\nCodigo - Nome do item - Valor - Categoria - Unidade de Medida - Ponto de Pedido - Saldo\n")
                    for item in self.armazem:
                        print(f"{item.codigo} - {item.nome} - {item.valor} - {item.categoria} - {item.unid_medida} - {item.ponto_pedido} - {item.saldo}.\n")
                        if item.isPontoPed():
                            abaixo_ponto_ped.append(item)
                    if len(abaixo_ponto_ped) >= 1:
                        print("\nOs seguintes itens estão abaixo do Ponto de Pedido: ")
                        print("\nCodigo - Nome do item - Valor - Categoria - Unidade de Medida - Ponto de Pedido - Saldo.\n")
                        for item in abaixo_ponto_ped:
                            print(f"{item.codigo} - {item.nome} - {item.valor} - {item.categoria} - {item.unid_medida} - {item.ponto_pedido} - {item.saldo}.\n")
                    if pergunta("Deseja voltar ao menu?"):
                        continue
                    else:
                        self.fechar()
                        break

                case 7:
                    soma_total = 0
                    for item in self.armazem:
                        valor_por_produto = item.saldo * item.valor
                        soma_total += valor_por_produto
                    print(f"\nO valor total de estoque é de: R${soma_total}")
                    if pergunta("Deseja voltar ao menu?"):
                        continue
                    else:
                        self.fechar()
                        break

                case 8:
                    if len(self.armazem) <= 0:
                        print("\nNão há itens para deletar. Retornando ao menu...")
                        sleep(3)
                        continue
                    self.delete_item()

                case 9:
                    self.fechar()
                    break

                case _:
                    print("\nSelecione uma opcao valida: ")
                    continue


estoque1 = Estoque("Estoque 2")

estoque1.menu_estoque()